# Copy this file to .env.daraja.local (already gitignored via .env.* in the root
# .gitignore) and fill in real values from your Daraja sandbox app. Never commit the copy,
# never paste its values in chat/logs - see docs/production-readiness.md and the brief's
# own rule for SLACK_WEBHOOK_URL, same principle applies here.

# From your app's main page (Consumer Key / Consumer Secret pair)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# From the "Lipa Na M-Pesa Sandbox" product's simulator page
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# From the "M-Pesa Sandbox" (B2B/B2C/C2B) product's test credentials section
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=

# Must be a real, internet-reachable HTTPS URL - Daraja's sandbox calls back to this for
# both STK and B2C results. Points at the real deployed payments service through the public
# API Gateway endpoint (see infra/outputs.tf's api_endpoint), not localhost.
DARAJA_CALLBACK_BASE_URL=https://6lak1mzcai.execute-api.eu-west-1.amazonaws.com
