{
  "title": "TillFlow overview",
  "uid": "tillflow-overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "window",
        "type": "custom",
        "query": "5m,1h,28d",
        "current": { "text": "1h", "value": "1h" },
        "label": "Window"
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "RED - request rate, errors, duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Request rate (per target group)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "datasource": { "type": "cloudwatch", "uid": "CloudWatch" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "pos", "namespace": "AWS/ApplicationELB", "metricName": "RequestCountPerTarget", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-pos-tg" }, "region": "eu-west-1", "label": "pos" },
        { "refId": "payments", "namespace": "AWS/ApplicationELB", "metricName": "RequestCountPerTarget", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-payments-tg" }, "region": "eu-west-1", "label": "payments" },
        { "refId": "commission", "namespace": "AWS/ApplicationELB", "metricName": "RequestCountPerTarget", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-commission-tg" }, "region": "eu-west-1", "label": "commission" },
        { "refId": "web", "namespace": "AWS/ApplicationELB", "metricName": "RequestCountPerTarget", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-web-tg" }, "region": "eu-west-1", "label": "web" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors - 5xx count (target-level + ALB-level)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "datasource": { "type": "cloudwatch", "uid": "CloudWatch" },
      "targets": [
        { "refId": "pos", "namespace": "AWS/ApplicationELB", "metricName": "HTTPCode_Target_5XX_Count", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-pos-tg" }, "region": "eu-west-1", "label": "pos" },
        { "refId": "payments", "namespace": "AWS/ApplicationELB", "metricName": "HTTPCode_Target_5XX_Count", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-payments-tg" }, "region": "eu-west-1", "label": "payments" },
        { "refId": "commission", "namespace": "AWS/ApplicationELB", "metricName": "HTTPCode_Target_5XX_Count", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-commission-tg" }, "region": "eu-west-1", "label": "commission" },
        { "refId": "web", "namespace": "AWS/ApplicationELB", "metricName": "HTTPCode_Target_5XX_Count", "statistic": "Sum", "dimensions": { "TargetGroup": "devops-g5-web-tg" }, "region": "eu-west-1", "label": "web" },
        { "refId": "elb", "namespace": "AWS/ApplicationELB", "metricName": "HTTPCode_ELB_5XX_Count", "statistic": "Sum", "region": "eu-west-1", "label": "ALB itself (see docs/recovery-drills.md)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duration - p95 response time vs SLO target (docs/slo-error-budgets.md: pos 400ms, web 500ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "datasource": { "type": "cloudwatch", "uid": "CloudWatch" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 400 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "pos", "namespace": "AWS/ApplicationELB", "metricName": "TargetResponseTime", "statistic": "p95", "dimensions": { "TargetGroup": "devops-g5-pos-tg" }, "region": "eu-west-1", "label": "pos (SLO: 400ms)" },
        { "refId": "payments", "namespace": "AWS/ApplicationELB", "metricName": "TargetResponseTime", "statistic": "p95", "dimensions": { "TargetGroup": "devops-g5-payments-tg" }, "region": "eu-west-1", "label": "payments" },
        { "refId": "commission", "namespace": "AWS/ApplicationELB", "metricName": "TargetResponseTime", "statistic": "p95", "dimensions": { "TargetGroup": "devops-g5-commission-tg" }, "region": "eu-west-1", "label": "commission" },
        { "refId": "web", "namespace": "AWS/ApplicationELB", "metricName": "TargetResponseTime", "statistic": "p95", "dimensions": { "TargetGroup": "devops-g5-web-tg" }, "region": "eu-west-1", "label": "web (SLO: 500ms)" }
      ]
    },
    {
      "type": "row",
      "title": "Saturation - healthy hosts + the shared RDS instance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Healthy hosts per service (desired_count=1 everywhere - see docs/production-readiness.md)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "datasource": { "type": "cloudwatch", "uid": "CloudWatch" },
      "fieldConfig": { "defaults": { "min": 0, "max": 2 }, "overrides": [] },
      "targets": [
        { "refId": "pos", "namespace": "AWS/ApplicationELB", "metricName": "HealthyHostCount", "statistic": "Average", "dimensions": { "TargetGroup": "devops-g5-pos-tg" }, "region": "eu-west-1", "label": "pos" },
        { "refId": "payments", "namespace": "AWS/ApplicationELB", "metricName": "HealthyHostCount", "statistic": "Average", "dimensions": { "TargetGroup": "devops-g5-payments-tg" }, "region": "eu-west-1", "label": "payments" },
        { "refId": "commission", "namespace": "AWS/ApplicationELB", "metricName": "HealthyHostCount", "statistic": "Average", "dimensions": { "TargetGroup": "devops-g5-commission-tg" }, "region": "eu-west-1", "label": "commission" },
        { "refId": "web", "namespace": "AWS/ApplicationELB", "metricName": "HealthyHostCount", "statistic": "Average", "dimensions": { "TargetGroup": "devops-g5-web-tg" }, "region": "eu-west-1", "label": "web" }
      ]
    },
    {
      "type": "timeseries",
      "title": "RDS - CPU %, connections, free storage (shared by pos/payments/commission)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "datasource": { "type": "cloudwatch", "uid": "CloudWatch" },
      "targets": [
        { "refId": "cpu", "namespace": "AWS/RDS", "metricName": "CPUUtilization", "statistic": "Average", "dimensions": { "DBInstanceIdentifier": "devops-g5-db" }, "region": "eu-west-1", "label": "CPU %" },
        { "refId": "conn", "namespace": "AWS/RDS", "metricName": "DatabaseConnections", "statistic": "Average", "dimensions": { "DBInstanceIdentifier": "devops-g5-db" }, "region": "eu-west-1", "label": "connections" }
      ]
    },
    {
      "type": "row",
      "title": "Business signal - async platform (infra/async.tf, no consumer wired up yet)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Commission-close queue depth (visible message count) - proves the EventBridge schedule fires, see docs/production-readiness.md for the missing consumer",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 26 },
      "id": 9,
      "datasource": { "type": "cloudwatch", "uid": "CloudWatch" },
      "targets": [
        { "refId": "visible", "namespace": "AWS/SQS", "metricName": "ApproximateNumberOfMessagesVisible", "statistic": "Maximum", "dimensions": { "QueueName": "devops-g5-commission-close" }, "region": "eu-west-1", "label": "commission-close queue depth" },
        { "refId": "dlq", "namespace": "AWS/SQS", "metricName": "ApproximateNumberOfMessagesVisible", "statistic": "Maximum", "dimensions": { "QueueName": "devops-g5-commission-close-dlq" }, "region": "eu-west-1", "label": "DLQ depth (should stay 0)" }
      ]
    }
  ]
}
